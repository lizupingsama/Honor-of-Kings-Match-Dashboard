# Database
DATABASE_URL="file:./players.db"

# 挂到域名子路径时填写（如 https://lizuping.love/wzry），本地开发可留空
# 修改后需重新 npm run build
# NEXT_BASE_PATH="/wzry"

# 数据源：camp（官方营地直连，推荐）| mock | apizero | apibyte | yujn
WZRY_API_PROVIDER="camp"

# --- 官方营地（camp）---
# 无需 API Key。在管理后台 /admin 用微信扫码登录营地后即可查询。
# 登录态保存在 data/camp-auth.json（勿提交到 git）
# 战绩同步：首次全量最多 8 页 / 100 条；之后增量只拉最新并与旧数据拼成最多 100 条
# （手动刷新与定时自动同步共用）
# 翻页间隔毫秒（防频控）
# CAMP_BATTLE_PAGE_DELAY_MS="400"

# --- 第三方备用（仅当 WZRY_API_PROVIDER 非 camp 时）---
# WZRY_API_BASE_URL="https://v1.apizero.cn/api/wzry-battle"
# WZRY_API_KEY=""

# 全国英雄战力查询（可选，默认如下；可与 WZRY_API_KEY 共用）
# WZRY_POWER_API_BASE_URL="https://v1.apizero.cn/api/wzry"

SYNC_COOLDOWN_SECONDS="300"
# 自动同步间隔：默认 3600 秒（1 小时）
AUTO_SYNC_INTERVAL_SECONDS="3600"
# 自动同步每个玩家之间的等待时间：默认 5 秒
AUTO_SYNC_PLAYER_DELAY_SECONDS="5"
# 进程内定时自动同步（npm run dev / start 时生效）；设为 false 可关闭
AUTO_SYNC_ENABLED="true"
LEADERBOARD_MIN_GAMES="10"

# 管理后台密码（默认 admin）
ADMIN_PASSWORD="admin"
# 可选：JWT 签名密钥（不填则复用 ADMIN_PASSWORD）
# ADMIN_SECRET=""
