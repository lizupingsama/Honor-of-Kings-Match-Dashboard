generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 以王者游戏昵称为单位的玩家档案（无需本站注册）
model Player {
  id            String  @id @default(cuid())
  /// 王者名称（展示与路由主键）
  gameNickname  String  @unique
  /// 营地 ID（拉取战绩用，可与昵称相同哈希生成）
  campId        String  @unique
  area          String  @default("wechat") // wechat | qq
  platform      String  @default("android")
  gameAvatarUrl String?
  currentRank   String?
  currentStars  Int     @default(0)
  /// 段位换算分（排位榜排序 / 段位曲线用，非 0-110 评分）
  tierScore     Int     @default(0)
  /// 排位评分（0–110）
  rankScore     Int     @default(0)
  /// 巅峰评分（0–110，不是巅峰分）
  peakRating    Int     @default(0)
  /// 巅峰分（巅峰赛积分）
  peakScore     Int     @default(0)
  seasonWins    Int     @default(0)
  seasonGames   Int     @default(0)
  mvpCount      Int     @default(0)
  goldCount     Int     @default(0)
  lastSyncAt    DateTime?
  lastSyncError String?
  queryCount    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches           Match[]
  heroStats         HeroStat[]
  syncJobs          SyncJob[]
  scoreHistories    ScoreHistory[]
  heroPowerHistories HeroPowerHistory[]
  likes             PlayerLike[]

  @@index([tierScore])
  @@index([rankScore])
  @@index([peakRating])
  @@index([peakScore])
  @@index([lastSyncAt])
  @@index([area])
  @@index([seasonGames])
}

/// 玩家点赞：同一浏览器（clientKey）对同一玩家每天最多一次
model PlayerLike {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// 浏览器本地生成的匿名 ID
  clientKey String
  /// 东八区日期 YYYY-MM-DD
  dayKey    String
  createdAt DateTime @default(now())

  @@unique([playerId, clientKey, dayKey])
  @@index([playerId])
}

/// 评分 / 巅峰分 / 胜率快照：以数据录入时间为轴
model ScoreHistory {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// 数据录入时间（曲线横轴）
  recordedAt DateTime @default(now())
  /// 排位评分 0–110
  rankScore  Int?
  /// 巅峰评分 0–110
  peakRating Int?
  /// 巅峰分
  peakScore  Int?
  /// 胜率百分比 0–100
  winRate    Float?
  /// sync | manual
  source     String   @default("manual")
  note       String?

  createdAt DateTime @default(now())

  @@index([playerId, recordedAt])
}

/// 英雄战力快照：按玩家+英雄，以录入时间为轴
model HeroPowerHistory {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  heroName    String
  heroId      String?
  recordedAt  DateTime @default(now())
  combatPower Int
  /// sync | manual
  source      String   @default("manual")
  note        String?

  createdAt DateTime @default(now())

  @@index([playerId, heroName, recordedAt])
  @@index([heroName, combatPower])
}

model Match {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  externalId  String
  playedAt    DateTime
  mode        String
  modeName    String?
  heroId      String?
  heroName    String
  heroIcon    String?
  result      String
  kills       Int      @default(0)
  deaths      Int      @default(0)
  assists     Int      @default(0)
  score       Float?
  evaluate    String?
  durationSec Int?
  rankName    String?
  stars       Int?
  rankScore   Int?
  /// 巅峰赛积分（对局后）
  peakScore   Int?
  /// 本场巅峰分变化（new - old）
  peakDelta   Int?
  /// 本场排位星数变化（相对上一场排位的 rankScore 差）
  rankDelta   Int?
  mvp         Boolean  @default(false)
  gold        Boolean  @default(false)
  /// 奖牌文案，如 银牌打野 / 金牌中路
  medal       String?
  /// 官方奖牌图标 URL（evaluateUrlV3）
  medalIcon   String?
  /// mvp | svp
  mvpType     String?
  /// 官方 MVP/SVP 图标 URL（mvpUrlV3 / mvpUrlV2）
  mvpIcon     String?
  /// 阵营：blue | red（来自营地 AcntCamp）
  side        String?
  economy     Int?
  /// 经济占本队比例（0–100，一位小数）
  economyPct  Float?
  damage      Int?
  /// 输出占本队比例（0–100，一位小数）
  damagePct   Float?
  /// 承伤英雄伤害（totalBeheroHurtCnt）
  takenDamage Int?
  /// 承伤占本队比例（0–100，一位小数）
  takenDamagePct Float?
  /// 参团率（0–100，一位小数）
  joinPct     Float?
  /// 对局时该英雄战力（营地 fightPower）
  combatPower Int?
  /// 出装 JSON：[{equipId,equipIcon,equipName},...]
  equipsJson  String?
  rawJson     String?

  createdAt DateTime @default(now())

  @@unique([playerId, externalId])
  @@index([playerId, playedAt])
  @@index([playerId, mode])
  @@index([heroName])
  @@index([side])
  @@index([medal])
}

model HeroStat {
  id          String  @id @default(cuid())
  playerId    String
  player      Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  heroId      String?
  heroName    String
  heroIcon    String?
  /// 该英雄当前战力
  combatPower Int     @default(0)
  games       Int     @default(0)
  wins        Int     @default(0)
  kills       Int     @default(0)
  deaths      Int     @default(0)
  assists     Int     @default(0)
  totalScore  Float   @default(0)
  /// 有评分的场次（算平均战绩用）
  scoreGames  Int     @default(0)
  /// 经济合计（仅含有经济数据的对局）
  totalEconomy Int    @default(0)
  /// 对应 totalEconomy 的对局时长合计（秒），用于分均经济
  totalDurationSec Int @default(0)
  totalDamage Int     @default(0)
  damageGames Int     @default(0)
  totalTakenDamage Int @default(0)
  takenGames  Int     @default(0)
  totalJoinPct Float  @default(0)
  joinGames   Int     @default(0)

  updatedAt DateTime @updatedAt

  @@unique([playerId, heroName])
  @@index([heroName, games])
  @@index([heroName, combatPower])
}

/// 访客访问记录：proxy 拦截页面请求逐条写入，滚动保留最近 10 万条（见 src/lib/visit-log.ts）
model Visit {
  /// 自增主键，同时用于按插入顺序修剪旧记录
  id        Int      @id @default(autoincrement())
  /// 真实客户端 IP（从 X-Forwarded-For 提取，见 src/lib/client-ip.ts）
  ip        String
  /// 去掉 basePath 与查询串的页面路径，如 /leaderboard
  path      String
  userAgent String?
  referer   String?
  /// 原始 X-Forwarded-For 链，排查伪造时用
  xff       String?
  /// server=proxy 服务端记录（含爬虫）；beacon=浏览器 JS 上报（真实访客）
  source    String   @default("server")
  createdAt DateTime @default(now())

  @@index([ip])
  @@index([createdAt])
  @@index([source])
}

model SyncJob {
  id         String    @id @default(cuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  status     String
  message    String?
  pulled     Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([playerId, startedAt])
  @@index([status])
}
